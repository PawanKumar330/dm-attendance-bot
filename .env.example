# ── Google Sheet ──────────────────────────────────────────────
# Option 1 (preferred): Spreadsheet ID from the URL
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=1f2XM7HFk0IYSiOyKYEKkNMd3j-lB6NgLS0qlh5M3o0M

# Option 2 (fallback): Sheet name (used only if SHEET_ID is blank)
SHEET_NAME=Discrete Mathematics

# Tab / worksheet name inside the spreadsheet (leave blank to use first tab)
WORKSHEET_NAME=Sheet1

# ── Google Credentials ────────────────────────────────────────
# Option A (local dev): Path to your service account JSON key file
GOOGLE_CREDS_PATH=credentials.json

# Option B (Render / cloud): Paste the ENTIRE content of credentials.json here
# Leave blank if using GOOGLE_CREDS_PATH above
GOOGLE_CREDENTIALS_JSON=

